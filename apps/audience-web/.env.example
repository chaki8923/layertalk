# 観客用 Web（Next.js）の環境変数。
#
# NEXT_PUBLIC_* 以外は **サーバ専用**で、Route Handler からしか読まない。
# 読み出しは src/lib/server/env.ts に集約してあり、無いと `Missing server environment
# variable: X` を投げる。投げた先は各ルートの catch で 500 に丸められるので、
# 画面には出ない — Vercel の Function ログ（`[billing/checkout]` 行）で確認すること。
#
# Vercel の環境変数はビルド時に注入される。**追加・変更したら再デプロイが必要**。

# ---------------------------------------------------------------- Supabase

# ブラウザに露出する前提の publishable キー。発表者用アプリと同じ値でよい。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# RLS を越えて書くためのキー。**絶対にクライアントへ出さない。**
# 旧名の SUPABASE_SERVICE_ROLE_KEY でも読む（env.ts の fallback）。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ---------------------------------------------------------------- 自分の URL

# Stripe の success_url / cancel_url と Stripe SDK の appInfo に使う。
# 末尾のスラッシュは付けても剥がされる。
NEXT_PUBLIC_APP_URL=https://<deployed-host>

# ---------------------------------------------------------------- Stripe

# 制限キー（restricted key）。Checkout Session の作成と、Customers の書き込み
# （customer_creation: "always" を使っている）を許可しておくこと。
STRIPE_RESTRICTED_KEY=rk_live_xxxxxxxxxxxx

# Stripe ダッシュボードで /api/billing/webhook 宛に作った endpoint の署名シークレット。
# **これがずれると決済は通るのに権利が付かない。** 一番気付きにくい壊れ方。
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Event Pass（¥2,980 / jpy）の価格 ID。fulfillment.ts が金額・通貨と併せて照合する。
STRIPE_EVENT_PASS_PRICE_ID=price_xxxxxxxxxxxx

# ---------------------------------------------------------------- Mac App Store / StoreKit 2

# App Store Connect のmacOSアプリとIAPの商品ID。未設定時は右辺の値が既定。
# 商品タイプは **Non-Renewing Subscription**（7日間の期間限定アクセスなので Consumable では
# 差し戻される）。発表者用アプリの VITE_APPLE_EVENT_PASS_PRODUCT_ID と必ず揃えること。
APPLE_BUNDLE_ID=app.layertalk.presenter
APPLE_EVENT_PASS_PRODUCT_ID=app.layertalk.presenter.event_pass

# App Store Connectで割り当てられる数値のApple ID。Sandbox/Xcodeテストでは省略可だが、
# Productionの署名検証には必須。
APPLE_APP_ID=1234567890

# App Store Server Notifications V2 の送信先:
# https://<deployed-host>/api/billing/app-store/notifications

# ---------------------------------------------------------------- 権利リース

# 直接配布版だけが使うEd25519の秘密鍵（PKCS#8 PEM）。改行は \n でエスケープして 1 行に収める。
# 発表者用アプリの VITE_ENTITLEMENT_PUBLIC_KEY はこれに対応する SPKI 公開鍵。
ENTITLEMENT_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# 鍵を差し替えるときだけ変える。未設定なら event-pass-v1。
# ENTITLEMENT_SIGNING_KEY_ID=event-pass-v1

# ---------------------------------------------------------------- 販売の可否

# "true" のときだけ **Stripe の** Event Pass を売る。それ以外は /api/billing/checkout が
# 503 を返し、発表者用アプリは「販売は現在準備中です」と出す。
# ⚠️ **Mac App Store の購入導線（/api/billing/app-store/*）はこのフラグを見ていない。**
# そのため `false` のまま App Store で売る、が成立してしまう。法務ページの検査
# （scripts/verify-billing-publication.mjs）は本番デプロイ（VERCEL_ENV=production）でも
# 走るようにしてあるので、どちらの経路でも下の LEGAL_* が欠けたままは出せない。
BILLING_PUBLICATION_ENABLED=false

# ---------------------------------------------------------------- CORS

# 発表者用アプリ（Tauri）から叩けるようにする追加 origin。カンマ区切り。
# リリース版の tauri://localhost は既定で通るので、ここに書くのは基本的に
# **dev ビルドから本番 API を叩きたいときの http://localhost:1420 だけ**。
# 恒久的に開けっぱなしにせず、不要になったら消して再デプロイすること。
# ALLOWED_TAURI_ORIGINS=http://localhost:1420

# ---------------------------------------------------------------- 保持期間の掃除

# /api/internal/retention を叩くための共有シークレット。Bearer で照合する。
CRON_SECRET=

# ---------------------------------------------------------------- 特商法・規約の表示値

# **本番デプロイ（VERCEL_ENV=production）または BILLING_PUBLICATION_ENABLED=true のとき必須。**
# src/content/legal/config.ts が読む。欠けていると各ページに
# `［販売事業者名を公開前に設定］` がそのまま出る（App Store 5.1.1(i) で止まる）。
#
# App Store 版でも、販売事業者・運営責任者・所在地・電話番号の4行は出る。決済の当事者が
# Apple でも、サービスを提供しているのは LayerTalk だから。チャネルで変わるのは
# 支払方法・提供時期・返金の窓口だけ（src/content/legal/channel.ts）。

# 販売事業者の名称。法人は登記上の商号、個人事業主は戸籍上の氏名（屋号だけでは足りない）。
# **Apple Developer Program の登録名義と揃えること** — Individual で登録すると
# App Store 上の販売者名が本名になるので、ここと食い違うと説明がつかなくなる。
LEGAL_SELLER_NAME=
# 運営統括責任者の氏名。法人なら代表者、個人事業主なら本人。
LEGAL_OPERATOR_NAME=
# 事業所の所在地。郵便番号から書く。個人事業主が自宅を公開したくない場合の扱いは
# 法務の判断（バーチャルオフィスを使う例が多い）。決めてから入れること。
LEGAL_ADDRESS=
# 日中に連絡が取れる電話番号。
LEGAL_PHONE=
# サポート窓口。**App Store Connect のサポート連絡先と同じアドレスにする。**
# ガイドライン 1.2 が UGC アプリに求める「公開された連絡先」もこれ。
# 出る場所が一番多い: 特商法・サポートページ・規約15条・プライバシー10条と13条・mailto。
LEGAL_SUPPORT_EMAIL=
# 問い合わせへの返信目安。守れる範囲で。例: 2〜3営業日以内
LEGAL_RESPONSE_TIME=
# 返金・キャンセル条件の本文。**直接配布（Stripe）版の文面**で、App Store 版には出ない
# （あちらは「返金は Apple が受け付ける」の固定文に差し替わる）。
# **「返金しない」ならしないと明示すること。** 特商法は条件の明示を求めていて、
# 空欄や曖昧な記載は不利に扱われる。
LEGAL_REFUND_POLICY=
# 任意。未設定なら動作環境の項を出さない。
# LEGAL_SYSTEM_REQUIREMENTS_URL=

# ---------------------------------------------------------------- 任意

# 入室時に Cloudflare Turnstile を出す。未設定なら CAPTCHA 無しで入室できる。
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# "true" のときだけ検索エンジンに拾わせる。既定は noindex。
# SEARCH_INDEXING_ENABLED=false
