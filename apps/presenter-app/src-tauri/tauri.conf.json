{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LayerTalk",
  "version": "0.1.0",
  "identifier": "app.layertalk.presenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "LayerTalk Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": false,
        "visible": false,
        "width": 1440,
        "height": 900
      },
      {
        "label": "control",
        "title": "LayerTalk コントロール",
        "width": 420,
        "height": 680,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
