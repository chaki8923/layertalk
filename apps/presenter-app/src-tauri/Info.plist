<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSScreenCaptureUsageDescription</key>
  <string>LayerTalk captures the presentation slide when an audience question arrives.</string>
  <!-- 通信は HTTPS のみ。Ed25519 は権利リースの「署名検証」＝認証にしか使っていないので
       非免除の暗号には当たらない。入れておかないとビルドのたびに App Store Connect が聞いてくる。 -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
