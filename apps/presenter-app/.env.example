# Supabase の publishable キー。クライアントに露出する前提のキーなので公開して問題ない。
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# 観客用 Web のデプロイ先。参加コードの URL と QR コードがこれを使う。
# 未設定なら http://localhost:3000 に落ちるが、その URL は観客のスマホからは開けない
# ＝ QR が意味を持たないので、デプロイしたら必ず設定する。
VITE_AUDIENCE_BASE_URL=https://<deployed-host>

# Stripe Checkout/権利APIは観客WebのNext.js Route Handlerにある。
VITE_BILLING_API_BASE_URL=https://<deployed-host>

# 署名済みEvent Passリースをオフライン検証するEd25519 SPKI PEM。
VITE_ENTITLEMENT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
